# Guide

guide: {
  metrics: count: entity: 2
  metrics: count: path: 1
  metrics: count: method: 2

  entity: render_page_get: {
    path: "/{apiKey}/": {
      rename: param: "apiKey": *"id"
      op: load: method: *GET
      op: load: transform: res: *("`body.pageResponses`")|top
    }
  }

  entity: render_page_post: {
    path: "/{apiKey}/": {
      rename: param: "apiKey": *"id"
      op: create: method: *POST
      op: create: transform: res: *("`body.pageResponses`")|top
    }
  }

}