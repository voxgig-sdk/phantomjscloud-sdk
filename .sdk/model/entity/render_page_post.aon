# Entity: render_page_post

main: kit: entity: render_page_post: {

  alias: field: {}

  fields: [
    {
      name: "events"
      req: false
      short: "Array of events that occurred during page load"
      type: "`$ARRAY`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "outputAsJson"
      req: false
      short: "Return response metadata as JSON including page events, resources loaded, errors, etc."
      type: "`$BOOLEAN`"
    }
    {
      name: "overseerScript"
      req: false
      short: "JavaScript code for page automation (ES2018 syntax)."
      type: "`$STRING`"
    }
    {
      name: "proxy"
      req: false
      short: "Proxy configuration: 'anon-any' (anonymous worldwide), 'anon-{country}' (country-specific), 'geo-{country}' (static IP), or 'custom-{url}:{port}:{user}:{pass}'"
      type: "`$STRING`"
    }
    {
      name: "renderType"
      req: false
      short: "Output format: plainText (web scraping), jpg/jpeg/png (screenshots), pdf (archiving), html (native form), automation (advanced control)"
      type: "`$STRING`"
    }
    {
      name: "requestSettings"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "suppressJson"
      req: false
      short: "List of JSON response fields to suppress for reduced verbosity"
      type: "`$ARRAY`"
    }
    {
      name: "url"
      req: true
      short: "The URL of the page to render"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "render_page_post"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                example: "ak-012345-abcde-012345-abcde-012345"
                kind: "param"
                name: "id"
                orig: "api_key"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "POST /{apiKey}/"
            json: "{\"operationId\":\"renderPagePost\",\"parameters\":[{\"description\":\"Your API key for authentication. Use 'a-demo-key-with-low-quota-per-ip-address' for demo (limited to 100 requests/day)\",\"example\":\"ak-012345-abcde-012345-abcde-012345\",\"in\":\"path\",\"name\":\"apiKey\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"examples\":{\"autoLogin\":{\"summary\":\"Auto-login example\",\"value\":{\"overseerScript\":\"let _user=\\\"USER@EXAMPLE.COM\\\"; let _pass=\\\"PASSWORD\\\"; await page.waitForSelector(\\\"input#username\\\"); await page.type(\\\"input#username\\\",_user,{delay:50}); await page.type(\\\"input#password\\\",_pass,{delay:50}); page.click(\\\"button[type=submit]\\\"); await page.waitForNavigation();\",\"renderType\":\"jpeg\",\"url\":\"https://www.linkedin.com/uas/login\"}},\"basicScreenshot\":{\"summary\":\"Basic JPEG screenshot\",\"value\":{\"renderType\":\"jpeg\",\"url\":\"https://example.com\"}},\"buttonClick\":{\"summary\":\"Click button and wait\",\"value\":{\"overseerScript\":\"page.manualWait(); await page.waitForSelector(\\\"button#dateBtn\\\"); page.click(\\\"button#dateBtn\\\"); await page.waitForFunction(()=>document.querySelector(\\\"#demo_result\\\").textContent!=\\\"\\\"); page.done();\",\"renderType\":\"jpeg\",\"url\":\"https://phantomjscloud.com/static-samples/button-click.html\"}},\"pdfRender\":{\"summary\":\"PDF render\",\"value\":{\"renderType\":\"pdf\",\"url\":\"https://example.com\"}},\"textExtraction\":{\"summary\":\"Plain text extraction\",\"value\":{\"renderType\":\"plainText\",\"url\":\"https://example.com\"}},\"withProxy\":{\"summary\":\"Using anonymous proxy\",\"value\":{\"proxy\":\"anon-any\",\"renderType\":\"jpeg\",\"url\":\"https://phantomjscloud.com/examples/helpers/requestdata\"}}},\"schema\":{\"properties\":{\"outputAsJson\":{\"default\":false,\"description\":\"Return response metadata as JSON including page events, resources loaded, errors, etc.\",\"type\":\"boolean\"},\"overseerScript\":{\"description\":\"JavaScript code for page automation (ES2018 syntax). Allows clicking, typing, waiting for elements, navigation, etc.\",\"example\":\"await page.waitForSelector('button'); page.click('button');\",\"type\":\"string\"},\"proxy\":{\"description\":\"Proxy configuration: 'anon-any' (anonymous worldwide), 'anon-{country}' (country-specific), 'geo-{country}' (static IP), or 'custom-{url}:{port}:{user}:{pass}'\",\"example\":\"anon-any\",\"type\":\"string\"},\"renderType\":{\"default\":\"plainText\",\"description\":\"Output format: plainText (web scraping), jpg/jpeg/png (screenshots), pdf (archiving), html (native form), automation (advanced control)\",\"enum\":[\"plainText\",\"jpg\",\"jpeg\",\"png\",\"pdf\",\"html\",\"automation\"],\"type\":\"string\"},\"requestSettings\":{\"properties\":{\"clearCache\":{\"default\":false,\"description\":\"Force all resources to reload instead of using cache\",\"type\":\"boolean\"},\"doneWhen\":{\"description\":\"Define when the page is considered 'done' loading\",\"items\":{\"properties\":{\"event\":{\"description\":\"Event to trigger completion: 'domReady' (DomContentLoaded) or 'loadFinished' (full load)\",\"enum\":[\"domReady\",\"loadFinished\"],\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"},\"suppressJson\":{\"description\":\"List of JSON response fields to suppress for reduced verbosity\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"url\":{\"description\":\"The URL of the page to render\",\"example\":\"https://example.com\",\"type\":\"string\"}},\"required\":[\"url\"],\"type\":\"object\"}}},\"description\":\"PageRequest object containing all rendering parameters\",\"required\":true},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Response when outputAsJson is true\",\"properties\":{\"content\":{\"description\":\"Rendered content based on renderType\",\"type\":\"string\"},\"pageResponses\":{\"properties\":{\"events\":{\"description\":\"Array of events that occurred during page load\",\"items\":{\"properties\":{\"key\":{\"description\":\"Type of event\",\"enum\":[\"resourceRequested\",\"resourceReceived\",\"browserError\"],\"type\":\"string\"},\"time\":{\"description\":\"Timestamp of the event\",\"format\":\"date-time\",\"type\":\"string\"},\"value\":{\"description\":\"Event-specific data\",\"type\":\"object\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"},\"statusCode\":{\"description\":\"HTTP status code of the rendered page\",\"type\":\"integer\"}},\"type\":\"object\"}},\"application/pdf\":{\"schema\":{\"format\":\"binary\",\"type\":\"string\"}},\"image/jpeg\":{\"schema\":{\"format\":\"binary\",\"type\":\"string\"}},\"image/png\":{\"schema\":{\"format\":\"binary\",\"type\":\"string\"}},\"text/html\":{\"schema\":{\"type\":\"string\"}},\"text/plain\":{\"schema\":{\"type\":\"string\"}}},\"description\":\"Successful page render\",\"headers\":{\"X-PhantomJsCloud-Page-Cost\":{\"description\":\"Cost of the page request in credits\",\"schema\":{\"type\":\"string\"}},\"X-PhantomJsCloud-Remaining-Quota\":{\"description\":\"Remaining quota for your API key\",\"schema\":{\"type\":\"string\"}}}},\"400\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"description\":\"Error message\",\"type\":\"string\"},\"message\":{\"description\":\"Detailed error description\",\"type\":\"string\"},\"statusCode\":{\"description\":\"HTTP status code\",\"type\":\"integer\"}},\"type\":\"object\"}}},\"description\":\"Bad Request - Invalid parameters\"},\"401\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"description\":\"Error message\",\"type\":\"string\"},\"message\":{\"description\":\"Detailed error description\",\"type\":\"string\"},\"statusCode\":{\"description\":\"HTTP status code\",\"type\":\"integer\"}},\"type\":\"object\"}}},\"description\":\"Unauthorized - Invalid API key\"},\"429\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"description\":\"Error message\",\"type\":\"string\"},\"message\":{\"description\":\"Detailed error description\",\"type\":\"string\"},\"statusCode\":{\"description\":\"HTTP status code\",\"type\":\"integer\"}},\"type\":\"object\"}}},\"description\":\"Too Many Requests - Quota exceeded\"},\"502\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"description\":\"Error message\",\"type\":\"string\"},\"message\":{\"description\":\"Detailed error description\",\"type\":\"string\"},\"statusCode\":{\"description\":\"HTTP status code\",\"type\":\"integer\"}},\"type\":\"object\"}}},\"description\":\"Bad Gateway - Server error (check ExpectContinue header)\"}},\"security\":[{\"ApiKeyAuth\":[]}],\"securitySchemes\":{\"ApiKeyAuth\":{\"description\":\"API key for authentication. Obtain from Dashboard.PhantomJsCloud.com. Demo key: 'a-demo-key-with-low-quota-per-ip-address' (100 requests/day limit)\",\"in\":\"path\",\"name\":\"apiKey\",\"type\":\"apiKey\"}},\"securitySource\":\"definition\"}"
            source: "openapi3"
            version: 1
          }
          method: "POST"
          orig: "/{apiKey}/"
          rename: {
            param: {
              apiKey: "id"
            }
          }
          segments: [
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.pageResponses`"
          }
        }
      ]
    }
  }



}
