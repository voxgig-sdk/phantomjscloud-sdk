 events, resources loaded, errors, etc.\",\"type\":\"boolean\"},\"overseerScript\":{\"description\":\"JavaScript code for page automation (ES2018 syntax). Allows clicking, typing, waiting for elements, navigation, etc.\",\"example\":\"await page.waitForSelector('button'); page.click('button');\",\"type\":\"string\"},\"proxy\":{\"description\":\"Proxy configuration: 'anon-any' (anonymous worldwide), 'anon-{country}' (country-specific), 'geo-{country}' (static IP), or 'custom-{url}:{port}:{user}:{pass}'\",\"example\":\"anon-any\",\"type\":\"string\"},\"renderType\":{\"default\":\"plainText\",\"description\":\"Output format: plainText (web scraping), jpg/jpeg/png (screenshots), pdf (archiving), html (native form), automation (advanced control)\",\"enum\":[\"plainText\",\"jpg\",\"jpeg\",\"png\",\"pdf\",\"html\",\"automation\"],\"type\":\"string\"},\"requestSettings\":{\"properties\":{\"clearCache\":{\"default\":false,\"description\":\"Force all resources to reload instead of using cache\",\"type\":\"boolean\"},\"doneWhen\":{\"description\":\"Define when the page is considered 'done' loading\",\"items\":{\"properties\":{\"event\":{\"description\":\"Event to trigger completion: 'domReady' (DomContentLoaded) or 'loadFinished' (full load)\",\"enum\":[\"domReady\",\"loadFinished\"],\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"},\"suppressJson\":{\"description\":\"List of JSON response fields to suppress for reduced verbosity\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"url\":{\"description\":\"The URL of the page to render\",\"example\":\"https://example.com\",\"type\":\"string\"}},\"required\":[\"url\"],\"type\":\"object\"}}},\"description\":\"PageRequest object containing all rendering parameters\",\"required\":true},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"Response when outputAsJson is true\",\"properties\":{\"content\":{\"description\":\"Rendered content based on renderType\"